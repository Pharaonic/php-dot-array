{
    "name": "pharaonic/php-dot-array",
    "description": "Read, write, check and delete values in deeply nested PHP arrays using dot-notation paths and wildcards.",
    "keywords": [
        "php",
        "array",
        "php array",
        "php dot array",
        "dot notation",
        "asterisk",
        "wildcard",
        "pharaonic"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com"
        }
    ],
    "homepage": "https://github.com/Pharaonic/php-dot-array",
    "support": {
        "issues": "https://github.com/Pharaonic/php-dot-array/issues",
        "source": "https://github.com/Pharaonic/php-dot-array",
        "security": "https://github.com/Pharaonic/php-dot-array/security/policy"
    },
    "require": {
        "php": ">=8.4 <8.5",
        "pharaonic/php-readable": "~8.4.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.18",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\DotArray\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\DotArray\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "phpcs",
        "format": "phpcbf",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
